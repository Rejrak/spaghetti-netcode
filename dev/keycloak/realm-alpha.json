{
  "realm": "alpha",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "authz-bank-send",
        "description": "Local E2E role for direct bank-send authorization",
        "attributes": {
          "supply.transaction.send": [
            "true"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "authz-middleware",
      "name": "Authorization middleware (DEVELOPMENT ONLY)",
      "description": "Local E2E client and secret; never reuse outside this disposable environment",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-authz-middleware-secret-do-not-reuse",
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "authz-console",
      "name": "Authorization console (DEVELOPMENT ONLY)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:5173/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://127.0.0.1:5173",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "authz-middleware-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "authz-middleware",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-authz-middleware",
      "enabled": true,
      "serviceAccountClientId": "authz-middleware",
      "clientRoles": {
        "realm-management": [
          "query-users",
          "view-realm",
          "view-users"
        ]
      }
    }
  ]
}
